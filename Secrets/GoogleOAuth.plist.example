<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Copy this file to Secrets/GoogleOAuth.plist and fill it in with the OAuth
	  client of type "Desktop app" from your own Google Cloud project.
	  See Docs/CODEX_PROMPT.md for how to create one.

	  Secrets/GoogleOAuth.plist is git-ignored. Tools/build_release.sh copies it
	  into the built app and re-signs, so released builds sign in with one button
	  while the credentials stay out of this repository.

	  For everyday development you do not need this file at all — run the app and
	  put your client into Settings → Account → Advanced instead.
	-->
	<key>ClientID</key>
	<string>PASTE_CLIENT_ID_HERE.apps.googleusercontent.com</string>
	<key>ClientSecret</key>
	<string>PASTE_CLIENT_SECRET_HERE</string>
</dict>
</plist>
